# =============================================================================
# ethglobal-lisboa-2026 — variables de entorno (EJEMPLO)
# Copiar a .env.local (dev) y configurar en el panel de deploy (prod).
# NUNCA commitear .env*. NUNCA poner private keys ni seed phrases aquí.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_URL="http://localhost:3000"
# Secreto para proteger endpoints /api/cron/* (genera uno aleatorio largo)
CRON_SECRET=""
# Código de invitación para el registro (/signup). Vacío = registro CERRADO.
SIGNUP_CODE=""
NODE_ENV="development"

# --- Supabase ----------------------------------------------------------------
# Panel del proyecto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""        # solo servidor / worker — NUNCA al cliente
SUPABASE_DB_URL=""                   # cadena de conexión Postgres (migraciones)

# --- The Graph (datos on-chain vía subgraphs) --------------------------------
# thegraph.com > Subgraph Studio > API Keys. Se usa contra el gateway.
THE_GRAPH_API_KEY=""
# URL base del gateway (por defecto el gateway descentralizado de The Graph).
THE_GRAPH_GATEWAY_URL="https://gateway.thegraph.com/api"

# --- RPC on-chain (viem: ENS, balances, lecturas ERC-20) — SOLO LECTURA ------
# Endpoint HTTP de un proveedor (Alchemy/Infura/público). No requiere claves privadas.
ETHEREUM_RPC_URL="https://eth.llamarpc.com"

# --- IA de runtime: Claude Code headless (suscripción, SIN API key) ----------
# El runner invoca Claude Code en modo headless autenticado por tu suscripción.
CLAUDE_CLI_PATH="claude"             # binario de Claude Code en el PATH del runner
CLAUDE_WORKDIR="./worker/agent"      # dir de trabajo del agente headless
CLAUDE_CODE_OAUTH_TOKEN=""           # `claude setup-token` — lo lee el runner
AI_POLL_MS="3000"                    # frecuencia del drain de ai_jobs
# NO se define ANTHROPIC_API_KEY: la IA de runtime usa la suscripción vía Claude Code.
