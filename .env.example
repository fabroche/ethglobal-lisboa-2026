# =============================================================================
# Seam — environment variables (EXAMPLE)
# Copy to .env.local (dev) and set in the deploy panel (prod). NEVER commit .env*.
# NEVER put user private keys or seed phrases here.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- 0G · sealed inference ----------------------------------------------------
# OpenAI-compatible router. MAINNET (see DA8 in 00-overview/05-open-decisions.md):
# testnet carries only two models and neither works for us — the TeeML one edits
# images, the chatbot one is TeeTLS. Hedera stays on testnet; separate decisions.
OG_ROUTER_URL="https://router-api.0g.ai/v1"

# Create at pc.0g.ai -> Console -> API Keys. Trust mode MUST be `Private` (TEE
# enclave): on Standard the model may run outside an enclave and there is no
# signature to verify, which removes the product. Set a 2 0G credit limit.
OG_KEY=""

# Pinned model (DA6). Chosen for `provider_count: 1` — a single provider means the
# enclave signing key cannot rotate, so OG_ENCLAVE_PUBKEY stays valid. glm-5.2 is
# the stronger model but has 3 providers, which would break that pin.
OG_MODEL="0gm-1.0-35b-a3b"

# Enclave signing key, for the independent attestation check (M7). We verify the
# response signature against this. tee_type=TDX, tee_verifier=dstack.
# STILL UNKNOWN: which endpoint serves it — 0G booth question.
OG_ENCLAVE_PUBKEY=""

# Enclave ENCRYPTION key, for `seal` (M2). NOT the same as the value above: for
# secp256k1 that one is a 20-byte address and you cannot encrypt to an address.
# STILL UNKNOWN: whether a separate key exists — 0G booth question.
OG_ENCLAVE_SEAL_PUBKEY=""

# --- Hedera · registry + clock + read -----------------------------------------
# HCS topic (commitments + verdict), Schedule Service (deadline), Mirror Node (read).
HEDERA_NETWORK="testnet"
HEDERA_ACCOUNT_ID=""
HEDERA_PRIVATE_KEY=""       # OUR testnet account only — never a user's key
HEDERA_TOPIC_ID=""          # created once, print it in the README

# --- World · one seat per side ------------------------------------------------
# Selfie Check as an abuse signal (not login). Action scoped per room at runtime.
WORLD_APP_ID=""
WORLD_ACTION=""
