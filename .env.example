# =============================================================================
# Seam — environment variables (EXAMPLE)
# Copy to .env.local (dev) and set in the deploy panel (prod). NEVER commit .env*.
# NEVER put user private keys or seed phrases here.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- 0G · sealed inference ----------------------------------------------------
# OpenAI-compatible router. Pin an exact model and record its hash for attestation.
OG_ROUTER_URL="https://router-api.0g.ai/v1"
OG_KEY=""
OG_MODEL=""                 # exact model id (pinned)
OG_ENCLAVE_PUBKEY=""        # enclave public key, for independent attestation check
OG_ENCLAVE_SEAL_PUBKEY=""   # enclave ENCRYPTION key (client sealing) — distinct from OG_ENCLAVE_PUBKEY
# NOTE: confirm the attestation verification package/endpoint at the 0G booth.
# seam-updated.md references `verifyEnvelope` from `@foundryprotocol/0gkit-attestation`.

# --- Hedera · registry + clock + read -----------------------------------------
# HCS topic (commitments + verdict), Schedule Service (deadline), Mirror Node (read).
HEDERA_NETWORK="testnet"
HEDERA_ACCOUNT_ID=""
HEDERA_PRIVATE_KEY=""       # OUR testnet account only — never a user's key
HEDERA_TOPIC_ID=""          # created once, print it in the README

# --- World · one seat per side ------------------------------------------------
# Selfie Check as an abuse signal (not login). Action scoped per room at runtime.
WORLD_APP_ID=""
WORLD_ACTION=""
